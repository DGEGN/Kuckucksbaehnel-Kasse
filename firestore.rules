rules_version = '2';

// WICHTIG: Diese Regeln ergänzen die der Fahrgastzählapp (Collection
// "fahrten") um vier neue Collections. Beim Veröffentlichen in der
// Firebase-Konsole beide Regelsätze zu EINER Datei zusammenführen,
// nicht die bestehenden "fahrten"-Regeln überschreiben.
//
// Der Block für "fahrten" unten ist nur als Orientierung gedacht — die
// Kassenapp legt "fahrten"-Dokumente nie selbst an (das macht ausschließlich
// die Fahrgastzählapp), sondern liest sie nur und erhöht beim Kauf per
// increment() die Felder "einzelperson"/"familien". Bitte beim Zusammenführen
// die tatsächlich in der Firebase-Konsole hinterlegten Regeln der
// Fahrgastzählapp verwenden, nicht diesen Block 1:1 übernehmen.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- aus der Fahrgastzählapp, nur zur Orientierung ---
    match /fahrten/{fahrtId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(
             ['fahrtag', 'sitzplaetze', 'einzelperson', 'familien', 'gruppen']);
      allow update: if request.auth != null;
      allow delete: if false;

      match /ereignisse/{eventId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasAll(['kategorie', 'anzahl', 'kasse'])
          && request.resource.data.kategorie in ['einzelperson', 'familien', 'gruppen'];
        allow delete: if request.auth != null;
        allow update: if false;
      }
    }

    // --- neu für die Kassenapp ---

    // Kassenbuch je Fahrtag (Dokument-ID = Fahrtag, z. B. "2026-09-01"), gemeinsam für alle Kassen
    match /kassenbuch/{kassenId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;

      // Einzelne Ein-/Auszahlungen, unveränderlich (kein nachträgliches Editieren)
      match /buchungen/{buchungId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasAll(['typ', 'betrag', 'kasse'])
          && request.resource.data.typ in ['einzahlung', 'auszahlung']
          && request.resource.data.betrag is int
          && request.resource.data.betrag > 0;
        allow update: if false;
        allow delete: if request.auth != null;
      }
    }

    // Verkaufsbericht je Fahrtag (Dokument-ID = Fahrtag)
    match /berichte/{berichtId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // Einzelne Verkäufe (Kassenbon-Positionen) je Fahrtag,
    // Grundlage für den automatischen Vorschlag im Verkaufsbericht
    match /verkaeufe/{verkaufId} {
      allow read: if request.auth != null;

      match /eintraege/{eintragId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasAll(['ticket', 'anzahl', 'summe', 'kasse'])
          && request.resource.data.anzahl is int
          && request.resource.data.anzahl > 0;
        allow update: if false;
        allow delete: if request.auth != null;
      }
    }

    // Globale Ticketpreise, ein einzelnes Dokument "preise"
    match /einstellungen/{einstellungId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
