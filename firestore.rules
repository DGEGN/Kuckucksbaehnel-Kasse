rules_version = '2';

// WICHTIG: Diese Regeln ergänzen die der Fahrgastzählapp (Collection
// "fahrten") um drei neue Collections. Beim Veröffentlichen in der
// Firebase-Konsole beide Regelsätze zu EINER Datei zusammenführen,
// nicht die bestehenden "fahrten"-Regeln überschreiben.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- aus der Fahrgastzählapp (unverändert übernehmen) ---
    match /fahrten/{fahrtId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(
             ['fahrtag', 'standort', 'sitzplaetze', 'erwachsene', 'kinder', 'familien', 'gruppen'])
        && request.resource.data.sitzplaetze is int
        && request.resource.data.sitzplaetze > 0
        && request.resource.data.standort in ['neustadt', 'lambrecht'];
      allow update: if request.auth != null;
      allow delete: if false;

      match /ereignisse/{eventId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasAll(['kategorie', 'anzahl', 'kasse'])
          && request.resource.data.kategorie in ['erwachsene', 'kinder', 'familien', 'gruppen'];
        allow delete: if request.auth != null;
        allow update: if false;
      }
    }

    // --- neu für die Kassenapp ---

    // Kassenbuch je Fahrtag/Standort (Dokument-ID: "YYYY-MM-DD_standort")
    match /kassenbuch/{kassenId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;

      // Einzelne Ein-/Auszahlungen, unveränderlich (kein nachträgliches Editieren)
      match /buchungen/{buchungId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasAll(['typ', 'betrag', 'kasse'])
          && request.resource.data.typ in ['einzahlung', 'auszahlung']
          && request.resource.data.betrag is int
          && request.resource.data.betrag > 0;
        allow update: if false;
        allow delete: if request.auth != null;
      }
    }

    // Verkaufsberichte je Fahrtag/Standort
    match /berichte/{berichtId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // Globale Ticketpreise, ein einzelnes Dokument "preise"
    match /einstellungen/{einstellungId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
